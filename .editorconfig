root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,csproj,props,targets,asmdef,yml,yaml}]
indent_size = 2

[*.cs]
# WZ 진단의 심각도는 여기서 바꾸지 않는다(T-42. CI가 거절한다).
csharp_style_namespace_declarations = block_scoped
