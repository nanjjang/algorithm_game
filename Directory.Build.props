<Project>
  <!--
    공통 빌드 설정 (ARCHITECTURE 3.4, DECISIONS-TECH T-43).
    - 출력은 전부 artifacts/ 로 간다. src/ 안에 bin/obj 가 생기면 Unity 가 DLL 을 중복으로 읽는다.
    - 경고는 오류다. WZ 진단을 끄는 설정(NoWarn, WarningsNotAsErrors, .editorconfig 심각도)은 CI 가 거절한다(T-42).
    - unity/ 아래는 unity/Directory.Build.props(빈 Project)가 이 파일을 끊는다.
  -->
  <PropertyGroup>
    <WizardRoot>$(MSBuildThisFileDirectory)</WizardRoot>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    프로젝트 묶음: 폴더 위치로 정한다 (shared = src/* 와 tests/Wizard.TestKit/Shared).
    견주는 두 값은 구분자를 '/' 로 맞춘 뒤 비교한다(T-67 6번). Windows 에서 NormalizeDirectory 는 '\' 를 내므로
    맞추지 않으면 묶음이 비고 분석기와 LangVersion 9.0 이 어느 프로젝트에도 걸리지 않는다.
  -->
  <PropertyGroup>
    <_WizardRootSlash>$([MSBuild]::NormalizeDirectory('$(WizardRoot)').Replace('\', '/'))</_WizardRootSlash>
    <_WizardProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').Replace('\', '/'))</_WizardProjectDir>
    <WizardGroup Condition="$(_WizardProjectDir.StartsWith('$(_WizardRootSlash)src/'))">shared</WizardGroup>
    <WizardGroup Condition="'$(_WizardProjectDir)' == '$(_WizardRootSlash)tests/Wizard.TestKit/Shared/'">shared</WizardGroup>
    <WizardGroup Condition="'$(WizardGroup)' == '' and $(_WizardProjectDir.StartsWith('$(_WizardRootSlash)server/'))">server</WizardGroup>
    <WizardGroup Condition="'$(WizardGroup)' == '' and $(_WizardProjectDir.StartsWith('$(_WizardRootSlash)tests/'))">tests</WizardGroup>
    <WizardGroup Condition="'$(WizardGroup)' == '' and $(_WizardProjectDir.StartsWith('$(_WizardRootSlash)tools/'))">tools</WizardGroup>
  </PropertyGroup>

  <!-- 공유 패키지: netstandard2.1 + C# 9 (Unity 6000.3 의 Roslyn 4.3.1). ARCHITECTURE 3.3 -->
  <PropertyGroup Condition="'$(WizardGroup)' == 'shared'">
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <!-- 결정론·계층 분석기(tools/Wizard.Analyzers)를 공유 패키지와 서버 프로젝트에 건다 (T-43) -->
  <ItemGroup Condition="('$(WizardGroup)' == 'shared' or '$(WizardGroup)' == 'server') and '$(MSBuildProjectName)' != 'Wizard.Analyzers'">
    <ProjectReference Include="$(WizardRoot)tools/Wizard.Analyzers/Wizard.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
