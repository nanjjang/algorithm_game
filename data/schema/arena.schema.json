{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.invalid/data/schema/arena.schema.json",
  "title": "전장 (data/sim/arena.json → 팩 절 12 arena)",
  "description": "DECISIONS 2.3, spec 01 5.6·3.7, world-characters 2.6, CONTRACTS 2.2 ArenaDef. 전장 하나가 모드 여럿에 쓰일 수 있고 모드마다 전장은 하나다(ContentDb.Arena(SimMode)). 좌표는 칸, 왼쪽 위 안쪽 모서리가 (0, 0), y 는 아래가 +(CONTRACTS 0.3).",
  "type": "object",
  "required": ["arenas"],
  "additionalProperties": false,
  "properties": {
    "_note": { "$ref": "_common.schema.json#/$defs/note" },
    "arenas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/arena" }
    }
  },
  "$defs": {
    "point": {
      "description": "칸 좌표 → FixVec2 Raw",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "y": { "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 }
      }
    },
    "arena": {
      "type": "object",
      "required": ["id", "modes", "width", "height", "pillars", "spawn_points"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "id": { "description": "장소 id(place.*, spec 14 2.3·3.13)", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^place\\." },
        "modes": {
          "description": "이 전장을 쓰는 모드(SimMode 의 이름을 소문자로). 모드는 데이터 전체에서 한 번만 나온다",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["endless", "duel", "plaza", "practice"] }
        },
        "width": { "description": "가로(칸) → Width Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "height": { "description": "세로(칸) → Height Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "pillars": {
          "description": "1×1칸 기둥. 그 칸의 작은 쪽 모서리(칸 좌표 (9,3) = 범위 x 9~10, y 3~4). → Pillars",
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "spawn_points": {
          "description": "시작 위치(판정 중심), 슬롯 순 → SpawnPoints",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    }
  }
}
