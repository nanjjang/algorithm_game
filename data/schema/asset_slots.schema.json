{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.invalid/data/schema/asset_slots.schema.json",
  "title": "그릴 그림 자리 (data/presentation/asset_slots.json, 팩에 들지 않는다)",
  "description": "어느 매니페스트에도 없고 콘텐츠 id 규칙으로도 나오지 않는 그림 자리(DECISIONS-TECH T-58 5번). 읽는 쪽: tools/Wizard.AssetCheck 의 assetcheck report. 레지스트리는 이 표를 읽지 않는다. 열쇠 (pack, id, variant) 는 겹치지 않는다(AssetSlotTable 이 본다).",
  "type": "object",
  "required": ["slots"],
  "additionalProperties": false,
  "properties": {
    "_note": { "$ref": "_common.schema.json#/$defs/note" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack", "id", "variant", "frame_size", "count", "spec"],
        "additionalProperties": false,
        "properties": {
          "pack": {
            "description": "AssetPack(CONTRACTS 13절)의 이름을 소문자로",
            "enum": ["ui", "character", "wand", "monster", "fx", "world", "background"]
          },
          "id": {
            "description": "AssetKey.Id. 캐릭터는 char.N, UI 는 I-W1 같은 에셋 ID, 그 밖은 콘텐츠 id 나 묶음/열쇠",
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-/]*$",
            "maxLength": 64
          },
          "variant": {
            "description": "AssetKey.Variant(반응 부품은 reactive/<부품 열쇠>, spec 14 9절 U-10)",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(/[a-z0-9][a-z0-9_]*)*$"
          },
          "frame_size": {
            "description": "프레임 하나의 [폭, 높이] px",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 1 }
          },
          "count": {
            "description": "그려야 하는 장수(상태와 프레임을 모두 센 값, spec 14 4.4절 '장수')",
            "type": "integer",
            "minimum": 1
          },
          "spec": {
            "description": "출처 명세 절(예: \"14 §4.6\")",
            "type": "string",
            "pattern": "^[0-9]{2} §[0-9.]+$"
          }
        }
      }
    }
  }
}
