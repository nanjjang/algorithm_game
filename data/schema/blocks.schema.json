{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.invalid/data/schema/blocks.schema.json",
  "title": "주문 블록 (data/sim/blocks.json → 팩 절 2 blocks)",
  "description": "spec 02 4.1·4.2, spec 14 3.3, CONTRACTS 2.2 BlockDef. 수는 원문 단위의 십진으로 적고 DataBuild 가 정수로 바꾼다(tools/Wizard.DataBuild/Convert/BlocksConverter.cs). flags·effect·params 는 DECISIONS-TECH T-53 의 ProjectileFlags·ModifierEffect·BlockParams 다. params 에 없는 값은 0(쓰지 않는다)이고, 표식·효과와 값의 짝은 변환기가 본다.",
  "type": "object",
  "required": ["blocks"],
  "additionalProperties": false,
  "properties": {
    "_note": { "$ref": "_common.schema.json#/$defs/note" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id", "kind", "rarity", "element", "heat", "heat_multiplier", "split_count", "base_damage",
        "interval_seconds", "speed", "instant", "range", "hit_radius", "damage_bonus", "flags", "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "id": { "description": "블록 id(block.*, spec 14 3.3)", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^block\\." },
        "kind": { "description": "블록 종류 → BlockKind(spec 14 3.3)", "enum": ["projectile", "control", "modifier"] },
        "rarity": { "description": "등급 → Rarity(spec 14 3.3)", "enum": ["common", "rare", "hero"] },
        "element": { "description": "속성 id(element.*). 무 속성은 element.neutral", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^element\\." },
        "heat": { "description": "더하는 열 → HeatHu(× 120). 제어 블록은 0", "$ref": "_common.schema.json#/$defs/heat", "minimum": 0 },
        "heat_multiplier": { "description": "열 배수(분열 1.6 / 2.2, 그 밖 1) → HeatMulPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "split_count": { "description": "갈래 수(분열 2 / 3, 그 밖 1) → SplitCount", "type": "integer", "minimum": 1 },
        "base_damage": { "description": "기본 피해(투사체) → BaseDamage Raw(× 2^32)", "type": "number", "minimum": 0 },
        "interval_seconds": { "description": "발사 간격(초, 코어일 때) → IntervalTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "speed": { "description": "탄속(칸/초). 즉발이면 0 → SpeedPerTick Raw(÷ 60)", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "minimum": 0 },
        "instant": { "description": "즉발 → IsInstant", "type": "boolean" },
        "range": { "description": "사거리(칸. 부메랑은 편도) → Range Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "hit_radius": { "description": "탄 판정 반지름(칸) → HitRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "damage_bonus": { "description": "변형 블록의 피해 보너스(0.2 = +20%) → DamageBonusPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "minimum": 0 },
        "flags": {
          "description": "투사체 블록의 동작 표식 → ProjectileFlags(spec 02 4.2). 변형·제어 블록은 빈 배열",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["explodes", "chains", "returns", "pass_through", "ignores_wolf_dodge"] }
        },
        "effect": {
          "description": "변형 블록의 효과 → ModifierEffect(spec 02 4.2). 투사체·제어 블록은 none",
          "enum": ["none", "bounce", "pierce", "size", "homing", "frost", "triple_heat", "corrosion"]
        },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "params": {
      "description": "블록마다 다른 동작 값 → BlockParams(spec 02 4.1 메모, 4.2, 9.3, 10.4, 12절, 18절 U6~U12). 그 블록이 쓰는 값만 적는다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "explosion_radius": { "description": "폭발 반경(칸, explodes) → ExplosionRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "chain_hops": { "description": "전이 횟수(chains. 첫 타는 세지 않는다) → ChainHops", "type": "integer", "minimum": 1 },
        "chain_radius": { "description": "전이 반경(칸, chains) → ChainRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "chain_hop_multiplier": { "description": "전이마다의 피해 배율(chains, 0.7) → ChainHopMulPermille(× 1000). 코어의 표(PowBase.Chain07)와 같아야 한다", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0, "maximum": 1 },
        "return_arrive_radius": { "description": "돌아온 탄이 사라지는 쏜 사람 둘레의 반경(칸, returns) → ReturnArriveRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "return_max_distance": { "description": "돌아오는 길의 상한(칸, returns) → ReturnMaxDistance Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "slow_percent": { "description": "맞은 적의 이동 감속(%, 30 = −30%) → SlowPermille(× 10). 투사체 블록과 효과 frost", "$ref": "_common.schema.json#/$defs/percent", "exclusiveMinimum": 0, "exclusiveMaximum": 100 },
        "slow_seconds": { "description": "감속 지속(초) → SlowTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "damage_taken_bonus_percent": { "description": "맞은 적이 받는 피해 증가(%, 15 = +15%) → DamageTakenBonusPermille(× 10). 효과 corrosion", "$ref": "_common.schema.json#/$defs/percent", "exclusiveMinimum": 0 },
        "damage_taken_bonus_seconds": { "description": "받는 피해 증가의 지속(초) → DamageTakenBonusTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "fan_half_angle_degrees": { "description": "분열 부채꼴의 반각(도. 2갈래 10 = ±10도, 3갈래 15 = −15 / 0 / +15도) → FanHalfAngleCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "exclusiveMinimum": 0, "maximum": 90 },
        "bounce_count": { "description": "블록 1개당 벽 튕김 횟수(효과 bounce) → BounceCount", "type": "integer", "minimum": 1 },
        "pierce_count": { "description": "블록 1개당 더 지나가는 적의 수(효과 pierce) → PierceCount", "type": "integer", "minimum": 1 },
        "radius_multiplier": { "description": "판정 반지름 배수(효과 size, 2 = 2배) → RadiusMulPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 1 },
        "radius_multiplier_cap": { "description": "겹쳤을 때 반지름 배수의 상한(효과 size, 4 = 4배) → RadiusMulCapPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 1 },
        "homing_turn_degrees_per_second": { "description": "유도의 선회각(도/초, 효과 homing) → HomingTurnCentiPerTick(× 100 ÷ 60)", "type": "number", "exclusiveMinimum": 0 },
        "homing_cone_half_degrees": { "description": "유도가 대상을 찾는 시야의 반각(도, 90 = 앞 ±90도) → HomingConeHalfCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "exclusiveMinimum": 0, "maximum": 180 },
        "homing_range": { "description": "유도가 대상을 찾는 거리(칸) → HomingRange Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "crit_multiplier": { "description": "임계 배율을 이 값으로 교체(효과 triple_heat, 3) → CritMultiplier", "type": "integer", "minimum": 2 }
      }
    }
  }
}
