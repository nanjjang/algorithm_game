{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.invalid/data/schema/bosses.schema.json",
  "title": "보스 (data/sim/bosses.json → 팩 절 6 bosses)",
  "description": "spec 06 1~8절·12절, spec 14 3.8, CONTRACTS 2.2 BossDef. 수는 원문 단위의 십진으로 적고 DataBuild 가 정수로 바꾼다(tools/Wizard.DataBuild/Convert/BossesConverter.cs). 스키마는 꼴과 범위만 본다. 단계의 순서·패턴 참조·덮어쓰기의 짝·공격의 짝은 변환기가, 회피 검산(R1~R4)과 속성 분배(보스의 저항 = 자기 속성 포함)는 databuild check 의 검증기가 본다. 공격 한 줄(attack)의 꼴은 적(enemies.schema.json 의 attack)과 같고, 피해 0(서리밭)과 남는 구역의 상한 0(상한 없음)만 더 받는다.",
  "type": "object",
  "required": ["common", "bosses"],
  "additionalProperties": false,
  "properties": {
    "_note": { "$ref": "_common.schema.json#/$defs/note" },
    "common": { "$ref": "#/$defs/common" },
    "bosses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/boss" }
    }
  },
  "$defs": {
    "patternKey": {
      "description": "보스 안의 패턴 열쇠(spec 06 1.5 의 <보스>.<패턴> 에서 뒤쪽) → BossPatternDef.PatternKey. 보스마다 쓸 수 있는 열쇠는 변환기가 본다",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "optionalCells": {
      "description": "칸 또는 null(없음)",
      "anyOf": [
        { "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        { "type": "null" }
      ]
    },
    "common": {
      "description": "모든 보스가 같이 쓰는 규칙 수치(spec 06 2.3·2.4·2.8·2.11·2.12) → BossDef.Common",
      "type": "object",
      "required": [
        "intro_seconds", "phase_transition_seconds", "wait_seconds", "no_candidate_wait_seconds", "r5_retry_seconds", "r5_repick_seconds",
        "rage_stack_seconds", "rage_max_stacks", "rage_step_ratio", "final_rage_seconds", "final_rage_damage_plus", "action_halt_seconds", "contact_cooldown_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "intro_seconds": { "description": "등장(초) → IntroTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "phase_transition_seconds": { "description": "단계 전환 멈춤(초) → PhaseTransitionTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "wait_seconds": { "description": "패턴 사이 기본 대기(초) → WaitTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "no_candidate_wait_seconds": { "description": "고를 패턴이 없을 때 늘리는 대기(초) → NoCandidateWaitTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "r5_retry_seconds": { "description": "R5 막힘 재검사 간격(초) → R5RetryTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "r5_repick_seconds": { "description": "R5 막힘이 이보다 길면 다른 패턴(초) → R5RepickTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "rage_stack_seconds": { "description": "격노 1스택마다(초) → RageStackTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "rage_max_stacks": { "description": "격노 최대 스택 → RageMaxStacks", "type": "integer", "minimum": 1 },
        "rage_step_ratio": { "description": "스택당 대기·연사 간격 감소(0.1 = 10%) → RageStepPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "final_rage_seconds": { "description": "최종 격노 시작(초) → FinalRageTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "final_rage_damage_plus": { "description": "최종 격노의 모든 공격 피해 +칸 → FinalRageDamagePlus", "type": "integer", "minimum": 0 },
        "action_halt_seconds": { "description": "⑨ 뇌광창 기절 대신 동작 멈춤(초) → ActionHaltTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "contact_cooldown_seconds": { "description": "같은 보스의 접촉 피해 간격(초) → ContactCooldownTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 }
      }
    },
    "boss": {
      "type": "object",
      "required": [
        "id", "rotation_index", "base_hp", "hp_scale_anchor_wave", "move_speed", "move_speed_on_frost", "contact_damage", "body_radius",
        "element", "weak", "resist", "phases", "patterns", "second_cycle"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "id": { "description": "보스 id(boss.*, spec 14 3.8) → BossId", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^boss\\." },
        "rotation_index": { "description": "보스 순번(0 가마등 … 5 밤삼킴, spec 06 1.3·2.1) → RotationIndex", "type": "integer", "minimum": 0, "maximum": 5 },
        "base_hp": { "description": "웨이브 10 기준 체력 → BaseHp", "type": "integer", "minimum": 1 },
        "hp_scale_anchor_wave": { "description": "체력 배율의 기준 웨이브(spec 06 2.2: hpMax = 기본 × H(w) ÷ H(기준)) → HpScaleAnchorWave", "type": "integer", "minimum": 1 },
        "move_speed": { "description": "이동 속도(칸/초) → MoveSpeedCenti(× 100)", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "exclusiveMinimum": 0 },
        "move_speed_on_frost": {
          "description": "플레이어가 서리밭 안일 때 걷는 속도(칸/초) → MoveSpeedOnFrostCenti. null 이면 서리밭과 상관없다",
          "anyOf": [{ "$ref": "_common.schema.json#/$defs/cellsPerSecond", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "contact_damage": { "description": "몸 접촉 피해(칸) → ContactDamage", "type": "integer", "minimum": 0, "maximum": 3 },
        "body_radius": { "description": "몸 판정 반지름(칸) → BodyRadius Raw. 밤삼킴은 머리", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "element": { "description": "자기 속성(element.*) → Element. 속성 없는 보스는 element.neutral", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^element\\." },
        "weak": { "description": "약점 속성 → Weak", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^element\\." },
        "resist": { "description": "저항 속성 → Resist", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^element\\." },
        "movement": { "$ref": "#/$defs/movement" },
        "phantom_copy": { "$ref": "#/$defs/phantomCopy" },
        "first_encounter": { "$ref": "#/$defs/firstEncounter" },
        "body": { "$ref": "#/$defs/body" },
        "phases": {
          "description": "단계(spec 06 1.4). 1단계부터 차례로, 들어가는 체력 % 내림차순. 2개 또는 3개",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/phase" }
        },
        "patterns": {
          "description": "패턴과 상시 행동(spec 06 1.5) → Patterns(PatternKey 오름차순)",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/pattern" }
        },
        "second_cycle": {
          "description": "2회차(웨이브 70 이상) 강화(spec 06 2.6) → SecondCycle",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/override" }
        }
      }
    },
    "movement": {
      "description": "이동 AI 의 거리(spec 06 4.3 허상 [임시: U14]) → Movement. 적지 않은 칸은 0",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "keep_distance": { "description": "플레이어와 유지하는 거리(칸) → KeepDistance Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "wall_margin": { "description": "벽에서 떨어지는 거리(칸) → WallMargin Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 }
      }
    },
    "phantomCopy": {
      "description": "허상의 복사 규칙(spec 06 4.2·4.4 TransformForPhantom) → PhantomCopy",
      "type": "object",
      "required": [
        "interval_ratio", "max_projectiles", "speed", "damage", "bounce_cap", "explosion_radius_ratio", "explosion_radius_max",
        "explosion_telegraph_seconds", "explosion_damage", "chain_line_telegraph_seconds", "chain_line_width", "chain_line_length",
        "split_min_angle_degrees", "copy_mutations_from_cycle"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "interval_ratio": { "description": "발사 간격 = 플레이어의 몇 배 → IntervalPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "max_projectiles": { "description": "발사 1회 최대 투사체 수 → MaxProjectiles", "type": "integer", "minimum": 1 },
        "speed": { "description": "모든 복사 탄의 속도(칸/초) → SpeedPerTick Raw", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "exclusiveMinimum": 0 },
        "damage": { "description": "복사 탄 피해(칸) → Damage", "type": "integer", "minimum": 1, "maximum": 3 },
        "bounce_cap": { "description": "벽 튕김 최대 횟수 → BounceCap", "type": "integer", "minimum": 0 },
        "explosion_radius_ratio": { "description": "폭발 반경 = 플레이어의 몇 배 → ExplosionRadiusPermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "explosion_radius_max": { "description": "폭발 반경 상한(칸) → ExplosionRadiusMax Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "explosion_telegraph_seconds": { "description": "폭발 예고 원(초) → ExplosionTelegraphTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "explosion_damage": { "description": "폭발 피해(칸) → ExplosionDamage", "type": "integer", "minimum": 1, "maximum": 3 },
        "chain_line_telegraph_seconds": { "description": "연쇄 번개 → 직선 번개의 조준 예고선(초) → ChainLineTelegraphTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "chain_line_width": { "description": "직선 번개 폭(칸) → ChainLineWidth Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "chain_line_length": { "description": "직선 번개 길이(칸) → ChainLineLength Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "split_min_angle_degrees": { "description": "분열 갈래 사이 최소 각(도) → SplitMinAngleCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "exclusiveMinimum": 0, "maximum": 180 },
        "copy_mutations_from_cycle": { "description": "변이를 복사하기 시작하는 회차 → CopyMutationsFromCycle", "type": "integer", "minimum": 1 }
      }
    },
    "firstEncounter": {
      "description": "허상과의 첫 만남(spec 06 9.2·9.5·9.6, 12절) → FirstEncounter",
      "type": "object",
      "required": ["hp_floor_percent", "max_fight_seconds", "rage_stacks", "start_phase", "finisher_seconds", "finisher_hp_zero_ticks", "collapse_seconds"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "hp_floor_percent": { "description": "체력 바닥(%) → HpFloorPercent", "type": "integer", "minimum": 1, "maximum": 99 },
        "max_fight_seconds": { "description": "싸움 최대 길이(초) → MaxFightTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "rage_stacks": { "description": "처음부터 쓰는 격노 스택 → RageStacks", "type": "integer", "minimum": 0 },
        "start_phase": { "description": "처음부터 쓰는 단계 → StartPhase", "type": "integer", "minimum": 1, "maximum": 3 },
        "finisher_seconds": { "description": "마무리 되비침(초) → FinisherTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 },
        "finisher_hp_zero_ticks": { "description": "되비침 시작에서 플레이어 체력이 0 이 되는 틱 → FinisherHpZeroTick", "$ref": "_common.schema.json#/$defs/ticks" },
        "collapse_seconds": { "description": "쓰러짐(초) → CollapseTicks", "$ref": "_common.schema.json#/$defs/seconds", "exclusiveMinimum": 0 }
      }
    },
    "body": {
      "description": "여러 부위로 된 몸(밤삼킴, spec 06 8.1) → Body",
      "type": "object",
      "required": ["head_radius", "segment_radius", "tail_radius", "segment_count", "segment_spacing", "segment_damage_ratio", "tail_damage_ratio", "max_segment_hits"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "head_radius": { "description": "머리 판정 반지름(칸) → HeadRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "segment_radius": { "description": "마디 판정 반지름(칸) → SegmentRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "tail_radius": { "description": "꼬리 판정 반지름(칸) → TailRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "segment_count": { "description": "몸 마디 수(꼬리 빼고) → SegmentCount", "type": "integer", "minimum": 1 },
        "segment_spacing": { "description": "마디 사이 간격(칸) → SegmentSpacing Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "segment_damage_ratio": { "description": "마디가 받는 피해 배율 → SegmentDamagePermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "tail_damage_ratio": { "description": "꼬리가 받는 피해 배율 → TailDamagePermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "max_segment_hits": { "description": "탄 한 발이 피해를 주는 마디·꼬리 수 상한 → MaxSegmentHits", "type": "integer", "minimum": 1 }
      }
    },
    "phase": {
      "type": "object",
      "required": ["index", "enter_at_hp_percent", "patterns", "passives", "tags"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "index": { "description": "단계 번호(1부터 차례로) → Index", "type": "integer", "minimum": 1, "maximum": 3 },
        "enter_at_hp_percent": { "description": "체력이 최대의 이 % 이하가 되면 들어간다(1단계는 100) → EnterAtHpPercent", "type": "integer", "minimum": 1, "maximum": 100 },
        "patterns": { "description": "이 단계에서 고를 수 있는 패턴 → Patterns", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/patternKey" } },
        "passives": { "description": "이 단계에서 도는 상시 행동 → Passives", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/patternKey" } },
        "tags": {
          "description": "이 단계의 꼬리표(tag.*, 늘 tag.boss 를 포함한다) → Tags. 1단계의 꼬리표가 처음 꼬리표다",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^tag\\." }
        },
        "anchor_radius": { "description": "이 단계 동안 전장 중앙에서 벗어나지 않는 반지름(칸, 천 갓 1단계 [임시: U60]) → AnchorRadius Raw. 적지 않으면 0(제한 없음)", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "overrides": { "description": "이 단계의 수치 변화(spec 06 1.4) → Overrides. 적지 않으면 없음", "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/override" } }
      }
    },
    "override": {
      "description": "패턴 단계 하나의 수치 바꾸기 → BossDef.PatternOverride. value 의 단위는 key 가 정한다: repeat·count·shard_count 정수, repeat_interval_seconds 초, repeat_angle_degrees·sweep_degrees·shard_spread_degrees 도, radius·inner_radius 칸, hazard_drift_speed 칸/초",
      "type": "object",
      "required": ["pattern", "step", "key", "value"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "pattern": { "$ref": "#/$defs/patternKey" },
        "step": { "description": "패턴 안 단계 첨자(0부터)", "type": "integer", "minimum": 0 },
        "key": {
          "description": "바꾸는 칸 → BossDef.OverrideKey",
          "enum": ["repeat", "count", "repeat_interval_seconds", "repeat_angle_degrees", "radius", "inner_radius", "sweep_degrees", "shard_count", "shard_spread_degrees", "hazard_drift_speed"]
        },
        "value": { "type": "number", "minimum": 0 }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["key", "passive", "graze", "recovery_seconds", "recovery_damage_ratio", "steps"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "key": { "$ref": "#/$defs/patternKey" },
        "passive": { "description": "상시 행동(패턴 고르기와 별개로 돈다) → IsPassive", "type": "boolean" },
        "graze": {
          "description": "패턴 표의 스침 열 → Graze(GrazeMask 비트)",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["bullet", "charge", "zone"] }
        },
        "recovery_seconds": { "description": "패턴 뒤 빈틈(초) → RecoveryTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "recovery_damage_ratio": { "description": "빈틈 동안 받는 피해 배율(가마등 기절 1.5) → RecoveryDamagePermille(× 1000)", "$ref": "_common.schema.json#/$defs/ratio", "exclusiveMinimum": 0 },
        "steps": {
          "description": "차례로 도는 단계 → Steps",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "description": "패턴의 단계 하나 → BossPatternDef.StepDef. attack·copy·summon 가운데 꼭 하나가 있다(변환기가 본다). 적지 않은 칸은 0, false, 없음이다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "attack": { "$ref": "#/$defs/attack" },
        "copy": { "$ref": "#/$defs/copy" },
        "summon": { "$ref": "#/$defs/summon" },
        "count": { "description": "한 번에 까는 구역·띠·졸개·마디 탄의 수 → Count. 적지 않으면 1", "type": "integer", "minimum": 1 },
        "repeat": { "description": "이 단계를 하는 횟수 → Repeat. 0 = 상시 행동이 이어서 계속. 적지 않으면 1", "type": "integer", "minimum": 0 },
        "repeat_interval_seconds": { "description": "반복의 시작 사이(초) → RepeatIntervalTicks. 0 = 앞 반복이 끝난 틱에", "$ref": "_common.schema.json#/$defs/seconds" },
        "repeat_angle_degrees": { "description": "반복마다 어긋나는 각(도) → RepeatAngleCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "minimum": 0, "maximum": 360 },
        "telegraph_each_repeat": { "description": "반복마다 예고를 다시 보인다 → TelegraphEachRepeat. false 면 첫 반복 앞에 한 번", "type": "boolean" },
        "start_delay_seconds": { "description": "앞 단계 판정 뒤 이 단계 시작까지(초) → StartDelayTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "rapid_fire": { "description": "연사형(격노로 반복·줄기 간격이 줄어든다, spec 06 2.12) → RapidFire", "type": "boolean" },
        "min_interval_ticks": { "description": "연사형 간격의 R3 하한(틱) → MinIntervalTicks", "$ref": "_common.schema.json#/$defs/ticks" },
        "frost_telegraph_seconds": { "description": "서리밭 안의 플레이어를 겨냥할 때의 예고(초) → FrostTelegraphTicks. 0 = 같음", "$ref": "_common.schema.json#/$defs/seconds" },
        "clear_hazard_margin": { "description": "새 예고가 시작되면 예고 띠 옆 이 거리 안의 자기 남는 구역을 지운다(칸) → ClearHazardMargin Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "hazard_speed_ratio": { "description": "남는 구역 안의 플레이어 이동 속도 배율(서리밭 0.7) → HazardSpeedPermille(× 1000). 0 = 바꾸지 않음", "$ref": "_common.schema.json#/$defs/ratio", "minimum": 0, "maximum": 1 },
        "hazard_drift_speed": { "description": "남는 구역이 플레이어 쪽으로 흐르는 속도(칸/초) → HazardDriftPerTick Raw(× 2^32 ÷ 60). 0 = 흐르지 않음(천 갓은 2회차 덮어쓰기로만)", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "minimum": 0 },
        "stream": { "$ref": "#/$defs/stream" },
        "placement": { "$ref": "#/$defs/placement" },
        "obstacle": { "$ref": "#/$defs/obstacle" }
      }
    },
    "stream": {
      "description": "쓸어 가며 이어 쏘는 탄 줄기(흰뿔 숨결) → Stream",
      "type": "object",
      "required": ["shots_per_second", "sweep_degrees", "sweep_degrees_per_second"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "shots_per_second": { "description": "초당 발수 → IntervalTicks(60 ÷ 발수, 나누어떨어져야 한다)", "type": "integer", "minimum": 1, "maximum": 60 },
        "sweep_degrees": { "description": "쓸어 가는 전체 각(도) → SweepCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "exclusiveMinimum": 0, "maximum": 360 },
        "sweep_degrees_per_second": { "description": "초당 도는 각(도) → SweepCentiPerTick(× 100 ÷ 60, 나누어떨어져야 한다)", "$ref": "_common.schema.json#/$defs/degrees", "exclusiveMinimum": 0 }
      }
    },
    "placement": {
      "description": "여러 구역을 놓는 자리(spec 06 3.4·5.4·7.7 [임시]) → Placement",
      "type": "object",
      "required": ["at_player", "min_player_distance", "max_player_distance", "min_spacing", "wall_margin", "max_tries"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "at_player": { "description": "플레이어 위치에 놓는 수 → AtPlayer", "type": "integer", "minimum": 0 },
        "min_player_distance": { "description": "나머지의 플레이어와의 중심 거리 아래 끝(칸) → MinPlayerDistance Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "max_player_distance": { "description": "위 끝(칸) → MaxPlayerDistance Raw. null = 없음(Raw 0)", "$ref": "#/$defs/optionalCells" },
        "min_spacing": { "description": "구역끼리 중심 거리 아래 끝(칸) → MinSpacing Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "wall_margin": { "description": "벽에서 중심까지 아래 끝(칸) → WallMargin Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "max_tries": { "description": "구역 하나당 거부 표본 추출 시도 수(넘으면 생략) → MaxTries", "type": "integer", "minimum": 1 }
      }
    },
    "obstacle": {
      "description": "판정 뒤 남는 장애물(바위, 얼음 기둥) → Obstacle",
      "type": "object",
      "required": ["kind", "radius", "duration_seconds", "hp", "max_count", "blocks_player_shots", "blocks_enemy_shots", "shards"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "kind": { "description": "→ BossPatternDef.ObstacleKind", "enum": ["boulder", "ice_pillar"] },
        "radius": { "description": "판정 반지름(칸) → Radius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "duration_seconds": { "description": "남는 시간(초) → DurationTicks. 0 = 깨질 때까지", "$ref": "_common.schema.json#/$defs/seconds" },
        "hp": { "description": "체력(웨이브 배율 없음) → Hp. 0 = 탄으로 깨지지 않는다", "type": "integer", "minimum": 0 },
        "max_count": { "description": "전장 동시 개수 상한 → MaxCount. 0 = 없음", "type": "integer", "minimum": 0 },
        "blocks_player_shots": { "description": "플레이어 탄을 막는다 → BlocksPlayerShots", "type": "boolean" },
        "blocks_enemy_shots": { "description": "적 탄을 막는다 → BlocksEnemyShots", "type": "boolean" },
        "shards": {
          "description": "깨질 때 퍼지는 파편 → Shards. null 이면 없음",
          "anyOf": [{ "$ref": "#/$defs/proj" }, { "type": "null" }]
        }
      }
    },
    "summon": {
      "description": "졸개 부르기 → Summon",
      "type": "object",
      "required": ["enemy", "count", "field_cap", "warn_seconds"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "enemy": { "description": "부르는 적 id(enemy.*) → Enemy", "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^enemy\\." },
        "count": { "description": "한 번에 부르는 수 → Count", "type": "integer", "minimum": 1 },
        "field_cap": { "description": "전장 동시 상한 → FieldCap. 0 = 없음", "type": "integer", "minimum": 0 },
        "warn_seconds": { "description": "나오기 전 땅의 금(초) → WarnTicks", "$ref": "_common.schema.json#/$defs/seconds" }
      }
    },
    "copy": {
      "description": "플레이어 지팡이 트리의 복사 발사(허상) → Copy",
      "type": "object",
      "required": ["arts", "fallback", "warn_seconds"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "arts": {
          "description": "따라 쓸 비기 후보(art.*). 빈 배열 = 트리 1회(복사 사격) → Arts",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^art\\." }
        },
        "fallback": {
          "description": "후보를 하나도 해금하지 않았을 때 쓰는 비기 → Fallback. null = 없음",
          "anyOf": [{ "$ref": "_common.schema.json#/$defs/contentId", "pattern": "^art\\." }, { "type": "null" }]
        },
        "warn_seconds": { "description": "쓰기 전 예고(커맨드 화살표, 발밑 선)(초) → WarnTicks", "$ref": "_common.schema.json#/$defs/seconds" }
      }
    },
    "attack": {
      "description": "공격 한 줄(spec 05 2.3 의 꼴, enemies.schema.json 의 attack 과 같다). 적지 않은 칸은 0, null, false, at_start, self 다. 보스는 서리밭(피해 0)과 상한 없는 남는 구역(max_count 0)을 더 쓴다",
      "type": "object",
      "required": ["key", "kind", "damage", "damage_source", "cooldown_seconds"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "key": { "description": "패턴 안의 단계 열쇠. 팩에는 없고 겹치는지만 본다", "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": {
          "description": "공격 종류 → AttackDef.AttackKind(spec 05 2.3 나열 순서)",
          "enum": ["contact", "dash", "zone", "aimed_shot", "spread", "ring_shot", "lob", "self_destruct", "tongue"]
        },
        "shape": {
          "description": "예고 모양 → Shape. null 이면 예고 구역 없음",
          "anyOf": [{ "enum": ["circle", "band", "fan", "aim_line", "ring"] }, { "type": "null" }]
        },
        "radius": { "description": "Circle·Fan 반지름, Ring 바깥 반지름(칸) → Radius Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "inner_radius": { "description": "Ring 안 반지름(칸) → InnerRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "width": { "description": "Band·AimLine 폭(칸) → Width Raw", "$ref": "_common.schema.json#/$defs/cells", "minimum": 0 },
        "length": {
          "description": "Band 길이(칸) → Length Raw. null 이면 벽까지",
          "anyOf": [{ "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "fan_degrees": { "description": "부채꼴 전체 각도(도) → FanCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "minimum": 0, "maximum": 180 },
        "range": { "description": "발동 사거리(칸) → Range Raw", "$ref": "#/$defs/optionalCells" },
        "trigger_min": { "description": "거리 조건 아래 끝(칸) → TriggerMin Raw", "$ref": "#/$defs/optionalCells" },
        "trigger_max": { "description": "거리 조건 위 끝(칸) → TriggerMax Raw", "$ref": "#/$defs/optionalCells" },
        "cast_seconds": { "description": "구역 없는 예고 동작(초) → CastTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "telegraph_seconds": { "description": "예고 길이(초) → TelegraphTicks. 모양이 있으면 0 보다 크다. 격노로 줄지 않는다", "$ref": "_common.schema.json#/$defs/seconds" },
        "lock": { "description": "방향 고정 → Lock", "enum": ["at_start", "last_n_ticks"] },
        "lock_seconds": { "description": "LastNTicks 의 n(초) → LockTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "anchor": { "description": "구역 위치 → Anchor", "enum": ["self", "player_pos_at_start", "player_pos_lead_ahead", "along_line_to_wall"] },
        "active_ticks": { "description": "판정 뒤 남아 움직이는 시간(틱) → ActiveTicks. 또아리의 가둠 240틱", "$ref": "_common.schema.json#/$defs/ticks" },
        "dash_speed": { "description": "돌진 속도(칸/초) → DashSpeedCenti(× 100)", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "minimum": 0 },
        "recovery_seconds": { "description": "공격 하나의 빈틈(초) → RecoveryTicks. 보스는 패턴의 recovery_seconds 를 쓴다", "$ref": "_common.schema.json#/$defs/seconds" },
        "damage": { "description": "종별 피해(칸, 성장 전) → Damage. 0 은 피해 없는 구역(서리밭)", "type": "integer", "minimum": 0, "maximum": 3 },
        "damage_source": { "description": "피해 분류 → Source(spec 05 2.1 DamageSource)", "enum": ["contact", "projectile", "telegraph", "lingering"] },
        "proj": {
          "description": "쏘는 탄 → Proj. null 이면 없음",
          "anyOf": [{ "$ref": "#/$defs/proj" }, { "type": "null" }]
        },
        "grazeable": { "description": "스쳐 피하기 대상 → Grazeable", "type": "boolean" },
        "is_dash": { "description": "돌진 → IsDash", "type": "boolean" },
        "lob": { "description": "포물선 → Lob", "type": "boolean" },
        "escape_override_milli": {
          "description": "검산용 벗어나는 거리(milli 칸) → EscapeOverrideMilli. null 이면 모양에서 계산",
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "cooldown_seconds": { "description": "재사용 대기(초) → CooldownTicks. 보스는 패턴 사이 대기를 쓰므로 0", "$ref": "_common.schema.json#/$defs/seconds" },
        "leaves_hazard": {
          "description": "판정 뒤 남는 위험 구역 → LeavesHazard. null 이면 없음",
          "anyOf": [{ "$ref": "#/$defs/hazard" }, { "type": "null" }]
        }
      }
    },
    "hazard": {
      "description": "남는 위험 구역(spec 05 2.1 HazardKind, 2.4). 피해는 늘 1칸이다(서리밭은 피해 없음)",
      "type": "object",
      "required": ["kind", "radius", "duration_seconds", "max_count", "contact_cooldown_seconds"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "kind": { "description": "→ AttackDef.HazardKind", "enum": ["thorn_field", "ember_strip", "spore_cloud", "frost_field"] },
        "radius": { "description": "반지름(칸, 띠는 반폭) → Radius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 },
        "duration_seconds": { "description": "남는 시간(초) → DurationTicks", "$ref": "_common.schema.json#/$defs/seconds" },
        "max_count": { "description": "전장 동시 개수 상한 → MaxCount. 0 = 없음", "type": "integer", "minimum": 0 },
        "contact_cooldown_seconds": { "description": "같은 구역의 접촉 피해 간격(초) → ContactCooldownTicks", "$ref": "_common.schema.json#/$defs/seconds" }
      }
    },
    "proj": {
      "type": "object",
      "required": ["speed", "count", "spread_degrees", "range", "hit_radius"],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "_common.schema.json#/$defs/note" },
        "speed": { "description": "탄속(칸/초) → SpeedPerTick Raw(× 2^32 ÷ 60)", "$ref": "_common.schema.json#/$defs/cellsPerSecond", "exclusiveMinimum": 0 },
        "count": { "description": "한 번에 쏘는 탄 수 → Count", "type": "integer", "minimum": 1 },
        "spread_degrees": { "description": "이웃한 탄 사이 각도(도) → SpreadCenti(× 100)", "$ref": "_common.schema.json#/$defs/degrees", "minimum": 0, "maximum": 360 },
        "range": {
          "description": "사거리(칸) → Range Raw. null 이면 벽에 닿을 때까지(Raw 0)",
          "anyOf": [{ "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "hit_radius": { "description": "탄 판정 반지름(칸) → HitRadius Raw", "$ref": "_common.schema.json#/$defs/cells", "exclusiveMinimum": 0 }
      }
    }
  }
}
