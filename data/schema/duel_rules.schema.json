        "burst_cap_percent",
        "post_hit_invuln_seconds",
        "hit_radius",
        "hit_center_offset_y",
        "chain_lightning_aim_seconds",
        "chain_lightning_jumps",
        "homing_turn_multiplier",
        "homing_seconds",
        "ice_spike_slow_percent",
        "ice_spike_slow_seconds",
        "frost_slow_percent",
        "frost_slow_seconds",
        "erosion_bonus_percent",
        "erosion_seconds",
        "status_apply_delay_ticks",
        "art_prep_ticks",
        "bullet_cap_per_player",
        "unstable_core_radius_multiplier",
