{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.invalid/data/schema/duel_rules.schema.json",
  "title": "결투 규칙 (data/sim/duel_rules.json → 팩 절 13 duel_rules)",
  "description": "spec 10 2.1~2.4·3.4·3.5·7.2~7.3·9.2, spec 04 8절, world-characters 5.4, CONTRACTS 2.2·3.9. DuelRuleSet 하나와 캐릭터마다 DuelCharacterOverride 하나. 변환기가 보는 것: 기본 라운드 수·길이가 match 와 같다, round_seconds − lead_seconds = start_seconds, 선택지에 겹침이 없고 기본값이 선택지·범위 안이다, 라운드 수는 홀수, 바닥 색은 낮·해질녘·밤, 캐릭터는 char.1~char.5 가 한 번씩.",
  "type": "object",
  "required": [
    "match",
    "thorns",
    "wild",
    "combat",
    "graze",
    "aim",
    "room",
    "characters"
  ],
  "additionalProperties": false,
  "properties": {
    "_note": {
      "$ref": "_common.schema.json#/$defs/note"
    },
    "match": {
      "description": "경기 형식(spec 10 2.1)",
      "type": "object",
      "required": [
        "players",
        "rounds_to_win",
        "round_seconds",
        "countdown_seconds",
        "intermission_seconds",
        "hp_per_cell",
        "round_start_heat",
        "round_start_crystals",
        "overtime_seconds",
        "overtime_damage_multiplier"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": {
          "$ref": "_common.schema.json#/$defs/note"
        },
        "players": {
          "description": "인원 → Players",
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "rounds_to_win": {
          "description": "선승 수 → RoundsToWin",
          "type": "integer",
          "minimum": 1
        },
        "round_seconds": {
          "description": "라운드 길이(초) → RoundLengthTicks(× 60)",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "countdown_seconds": {
          "description": "카운트다운(초) → CountdownTicks",
          "$ref": "_common.schema.json#/$defs/seconds"
        },
        "intermission_seconds": {
          "description": "라운드 사이 쉬는 시간(초) → IntermissionTicks [임시 U-26]",
          "$ref": "_common.schema.json#/$defs/seconds"
        },
        "hp_per_cell": {
          "description": "체력 칸 하나의 체력 → HpPerCell",
          "type": "integer",
          "minimum": 1
        },
        "round_start_heat": {
          "description": "라운드 시작 열 → RoundStartHeatHu(× 120)",
          "$ref": "_common.schema.json#/$defs/heat",
          "minimum": 0
        },
        "round_start_crystals": {
          "description": "라운드 시작 결정 → RoundStartCrystals",
          "type": "integer",
          "minimum": 0
        },
        "overtime_seconds": {
          "description": "연장(초) → OvertimeTicks",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "overtime_damage_multiplier": {
          "description": "연장 중 받는 피해 배율 → OvertimeDamagePermille(× 1000)",
          "$ref": "_common.schema.json#/$defs/ratio",
          "minimum": 1
        }
      }
    },
    "thorns": {
      "description": "가시밭(spec 10 2.1, 3.4)",
      "type": "object",
      "required": [
        "start_seconds",
        "lead_seconds",
        "step_seconds",
        "damage_interval_seconds",
        "damage_percent",
        "ring_max"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": {
          "$ref": "_common.schema.json#/$defs/note"
        },
        "start_seconds": {
          "description": "기본 라운드에서 가시밭이 시작하는 경과 시간(초) → ThornStartTicks",
          "$ref": "_common.schema.json#/$defs/seconds"
        },
        "lead_seconds": {
          "description": "라운드가 끝나기 몇 초 전부터 시작하나 → ThornLeadTicks [임시 U-02]",
          "$ref": "_common.schema.json#/$defs/seconds"
        },
        "step_seconds": {
          "description": "한 칸 들어오는 간격(초) → ThornStepTicks",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "damage_interval_seconds": {
          "description": "피해 간격(초) → ThornDamageIntervalTicks",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "damage_percent": {
          "description": "최대 체력 대비 피해(%) → ThornDamagePermille(× 10)",
          "$ref": "_common.schema.json#/$defs/percent",
          "minimum": 0,
          "maximum": 100
        },
        "ring_max": {
          "description": "고리 최대 칸 → ThornRingMax [임시 U-03]",
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "wild": {
      "description": "야생 난입(spec 10 2.1, 3.5)",
      "type": "object",
      "required": [
        "enemy",
        "spawn_interval_seconds",
        "spawn_count",
        "contact_damage",
        "contact_cooldown_seconds",
        "spawn_points"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": {
          "$ref": "_common.schema.json#/$defs/note"
        },
        "enemy": {
          "description": "슬라임 종류 → WildEnemy",
          "$ref": "_common.schema.json#/$defs/contentId",
          "pattern": "^enemy\\."
        },
        "spawn_interval_seconds": {
          "description": "출현 간격(초) → WildSpawnIntervalTicks",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "spawn_count": {
          "description": "한 번에 나오는 수 → WildSpawnCount",
          "type": "integer",
          "minimum": 1
        },
        "contact_damage": {
          "description": "접촉 피해(체력) → WildContactDamage",
          "type": "integer",
          "minimum": 0
        },
        "contact_cooldown_seconds": {
          "description": "한 마리가 같은 플레이어에게 다시 닿기까지(초) → WildContactCooldownTicks [임시 U-27]",
          "$ref": "_common.schema.json#/$defs/seconds",
          "exclusiveMinimum": 0
        },
        "spawn_points": {
          "description": "나오는 자리(칸, 돌마당 좌표) → WildSpawnPoints(Raw) [임시 U-27]",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "$ref": "_common.schema.json#/$defs/cells",
                "minimum": 0
              },
              "y": {
                "$ref": "_common.schema.json#/$defs/cells",
                "minimum": 0
              }
            }
          }
        }
      }
    },
