{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "작업 그래프 (docs/dev/tasks.json)",
 "description": "작업 그래프의 꼴. 그래프 규칙(deps의 존재와 순환, 경로 겹침, 묶음, 마일스톤 집계, 벡터 배정, 모델)은 스키마로 나타낼 수 없어서 taskgraph validate와 tools/check-tasks.mjs가 따로 본다. 진행 상태(in_progress, review, done)는 여기에 두지 않는다(.claude/taskstate.json, DECISIONS-TECH T-40).",
 "type": "object",
 "required": ["schema", "project", "notes", "agents", "milestones", "tasks"],
 "additionalProperties": false,
 "properties": {
  "schema": { "const": 2 },
  "project": { "type": "string", "minLength": 1 },
  "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
  "agents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/agent" } },
  "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestone" } },
  "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
 },
 "$defs": {
  "model": { "enum": ["fable", "opus", "sonnet", "haiku"] },
  "taskId": {
   "description": "M<번호>-<분류>-<번호>, M<번호>-INT, V-<번호>, CCR-<번호>, FIX-<번호>",
   "type": "string",
   "pattern": "^(M[0-9]+-[A-Z]+(-[0-9]+)?|V-[0-9]+|(CCR|FIX)-[0-9]+)$"
  },
  "milestoneId": { "type": "string", "pattern": "^(M[0-9]+|V)$" },
  "group": { "type": "string", "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$" },
  "nonEmptyString": { "type": "string", "minLength": 1 },
  "ownedPath": {
   "description": "저장소 기준 상대 경로. '/'로 끝나면 폴더 전체, '*'는 한 경로 마디 안에서만 맞는다. '**', 절대 경로, '.'·'..' 마디, 빈 마디, 역슬래시, 공백은 쓰지 않는다",
   "type": "string",
   "minLength": 1,
   "pattern": "^(?!/)(?!.*//)(?!.*\\*\\*)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\s]+$"
  },
  "agent": {
   "type": "object",
   "required": ["name", "default_model", "default_reviewer_model"],
   "additionalProperties": false,
   "properties": {
    "name": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "default_model": { "$ref": "#/$defs/model" },
    "default_reviewer_model": {
     "description": "검토하지 않는 에이전트(code-reviewer, doc-scout)는 null",
     "oneOf": [{ "$ref": "#/$defs/model" }, { "type": "null" }]
    }
   }
  },
  "milestone": {
   "type": "object",
   "required": ["id", "title", "gate", "task_count", "blocked_on_assets", "parallel_groups"],
   "additionalProperties": false,
   "properties": {
    "id": { "$ref": "#/$defs/milestoneId" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "gate": { "oneOf": [{ "$ref": "#/$defs/taskId" }, { "type": "null" }] },
    "task_count": { "type": "integer", "minimum": 0 },
    "blocked_on_assets": { "type": "integer", "minimum": 0 },
    "parallel_groups": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/group" } }
   }
  },
  "task": {
   "type": "object",
   "required": [
    "id", "milestone", "title", "module", "owner_agent", "owner_model", "reviewer_model",
    "deps", "spec_refs", "contracts", "owned_paths", "acceptance", "vectors", "parallel_group", "status"
   ],
   "additionalProperties": false,
   "properties": {
    "id": { "$ref": "#/$defs/taskId" },
    "milestone": { "$ref": "#/$defs/milestoneId" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "module": { "$ref": "#/$defs/nonEmptyString" },
    "owner_agent": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "owner_model": { "$ref": "#/$defs/model" },
    "reviewer_model": { "$ref": "#/$defs/model" },
    "deps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
    "spec_refs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "owned_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ownedPath" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "vectors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S[0-9][0-9](§[0-9]+\\.[0-9]+|:[A-Za-z0-9-]+(\\.\\.[A-Za-z0-9-]+)?)$" } },
    "parallel_group": { "$ref": "#/$defs/group" },
    "status": {
     "description": "처음 분류만. 진행 상태는 .claude/taskstate.json에 있다",
     "enum": ["todo", "blocked-on-assets"]
    },
    "human_check": { "$ref": "#/$defs/nonEmptyString" }
   }
  }
 }
}
