{
  "format": 1,
  "bundle": "fixmath-misc",
  "cases": [
    {"id": "sqrt-4", "op": "FixMath.Sqrt", "args": ["17179869184"], "expect": ["8589934592"]},
    {"id": "sqrt-2", "op": "FixMath.Sqrt", "args": ["8589934592"], "expect": ["6074000999"], "notes": "√2 × 2^32 = 6,074,000,999.95 → 내림"},
    {"id": "sqrt-epsilon", "op": "FixMath.Sqrt", "args": ["1"], "expect": ["65536"]},
    {"id": "sqrt-zero", "op": "FixMath.Sqrt", "args": ["0"], "expect": ["0"]},
    {"id": "sqrt-neg", "op": "FixMath.Sqrt", "args": ["-1"], "expect": ["0"], "notes": "v ≤ 0 → 0"},
    {"id": "sqrt-min", "op": "FixMath.Sqrt", "args": ["-9223372036854775808"], "expect": ["0"]},
    {"id": "sqrt-max", "op": "FixMath.Sqrt", "args": ["9223372036854775807"], "expect": ["199032864766430"]},
    {"id": "norm-zero", "op": "FixVec2.Normalized", "args": ["0", "0"], "expect": ["0", "0"], "notes": "길이 0 → (0,0)"},
    {"id": "norm-tiny", "op": "FixVec2.Normalized", "args": ["1", "0"], "expect": ["0", "0"], "notes": "LengthSq 가 0으로 내림 → (0,0)"},
    {"id": "norm-3-4", "op": "FixVec2.Normalized", "args": ["12884901888", "17179869184"], "expect": ["2576980377", "3435973836"], "notes": "0.6, 0.8 을 0 쪽 버림"},
    {"id": "norm-neg3-neg4", "op": "FixVec2.Normalized", "args": ["-12884901888", "-17179869184"], "expect": ["-2576980377", "-3435973836"]},
    {"id": "norm-1-1", "op": "FixVec2.Normalized", "args": ["4294967296", "4294967296"], "expect": ["3037000500", "3037000500"]},
    {"id": "norm-neg1-0", "op": "FixVec2.Normalized", "args": ["-4294967296", "0"], "expect": ["-4294967296", "0"]},
    {"id": "pow-enh-neg", "op": "FixMath.PowTable", "args": ["0", "-1"], "expect": ["4294967296"], "notes": "음수 → 0번"},
    {"id": "pow-enh-intmin", "op": "FixMath.PowTable", "args": ["0", "-2147483648"], "expect": ["4294967296"]},
    {"id": "pow-enh-13", "op": "FixMath.PowTable", "args": ["0", "13"], "expect": ["26426021613"], "notes": "spec 02 11절 표의 마지막 칸"},
    {"id": "pow-enh-14", "op": "FixMath.PowTable", "args": ["0", "14"], "expect": ["26426021613"], "notes": "넘침 → 마지막"},
    {"id": "pow-enh-intmax", "op": "FixMath.PowTable", "args": ["0", "2147483647"], "expect": ["26426021613"]},
    {"id": "pow-d085-3", "op": "FixMath.PowTable", "args": ["1", "3"], "expect": ["2637646791"], "notes": "spec 02 TV-A17: 0.614125"},
    {"id": "pow-d085-neg", "op": "FixMath.PowTable", "args": ["1", "-1"], "expect": ["4294967296"]},
    {"id": "pow-d092-3", "op": "FixMath.PowTable", "args": ["2", "3"], "expect": ["3344439494"], "notes": "spec 02 TV-A17: 0.778688"},
    {"id": "pow-d092-neg", "op": "FixMath.PowTable", "args": ["2", "-5"], "expect": ["4294967296"]},
    {"id": "pow-chain-3", "op": "FixMath.PowTable", "args": ["3", "3"], "expect": ["1473173783"], "notes": "0.343"},
    {"id": "pow-chain-intmin", "op": "FixMath.PowTable", "args": ["3", "-2147483648"], "expect": ["4294967296"]},
    {"id": "invsqrt2", "op": "FixMath.InvSqrt2Raw", "args": [], "expect": ["3037000500"], "notes": "spec 01 T-C08"}
  ]
}
