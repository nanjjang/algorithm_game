{
  "format": 1,
  "bundle": "saturate",
  "cases": [
    {"id": "sat-long-max", "op": "FixMath.SaturateToInt", "args": ["9223372036854775807"], "expect": ["2147483647"]},
    {"id": "sat-long-min", "op": "FixMath.SaturateToInt", "args": ["-9223372036854775808"], "expect": ["-2147483648"]},
    {"id": "sat-int-max", "op": "FixMath.SaturateToInt", "args": ["2147483647"], "expect": ["2147483647"]},
    {"id": "sat-int-max-p1", "op": "FixMath.SaturateToInt", "args": ["2147483648"], "expect": ["2147483647"]},
    {"id": "sat-int-min", "op": "FixMath.SaturateToInt", "args": ["-2147483648"], "expect": ["-2147483648"]},
    {"id": "sat-int-min-m1", "op": "FixMath.SaturateToInt", "args": ["-2147483649"], "expect": ["-2147483648"]},
    {"id": "sat-2pow32", "op": "FixMath.SaturateToInt", "args": ["4294967296"], "expect": ["2147483647"], "notes": "잘라 내기(래핑이면 0)"},
    {"id": "sat-zero", "op": "FixMath.SaturateToInt", "args": ["0"], "expect": ["0"]},
    {"id": "sat-neg1", "op": "FixMath.SaturateToInt", "args": ["-1"], "expect": ["-1"]}
  ]
}
