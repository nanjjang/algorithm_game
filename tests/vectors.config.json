{
  "format": 1,
  "description": "명세 테스트 벡터 id를 모으는 규칙과 테스트 이름 규칙. 읽는 쪽: Wizard.TestKit.Shared.Vectors(SpecVectorScanner, VectorNames), tools/Wizard.VectorCoverage. 정규식은 .NET과 JavaScript가 같이 읽는 꼴만 쓴다. 벡터 장 밖에서는 첫 칸이나 굵은 항목이 그 명세의 id 꼴인 표 줄·항목만 벡터다(spec 11 16절·17.5절). 자체 테스트: tests/Wizard.TestKit/SelfTests/VectorConfigTests.cs",
  "specDir": "docs/spec",
  "specFile": "^(?<spec>[0-9]{2})-[^/]*\\.md$",
  "chapter": "^## (?:(?<ch>[0-9]+)\\.)?",
  "vectorChapter": "^## [0-9]+\\. .*테스트 벡터",
  "subsection": "^### (?<sec>[0-9]+\\.[0-9]+)(?![0-9.])",
  "tableRow": "^\\|(?<cell>[^|]*)\\|",
  "tableIgnore": "^(?:ID|#|TV|:?-+:?|)$",
  "tableId": "^`?(?<id>[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*)(?<star>\\*)?`?(?:\\s*~\\s*`?(?<to>[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*)`?)?$",
  "boldItem": "^- \\*\\*(?<id>[^*]+)\\*\\*",
  "numberedItem": "^(?<num>[0-9]+)\\. ",
  "numberedPrefix": "N",
  "proseItem": "\\((?<id>[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*)(?:\\s*~\\s*(?<to>[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*|[0-9]+))?(?=\\s*[,)])",
  "idToken": "(?<![A-Za-z0-9-])[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*",
  "testName": "^S(?<spec>[0-9]{2})_(?<id>[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*)(?:__(?<desc>[A-Za-z0-9][A-Za-z0-9_]*))?$",
  "specs": {
    "01": { "id": "^T-[A-Z][0-9]{2}$", "example": "T-H04" },
    "02": { "id": "^TV-[A-Z][0-9]{2}$", "example": "TV-A01" },
    "03": { "id": "^(?:TV-A[0-9]{3}|B[0-9]{2}[a-z]?|S[0-9]{2})$", "example": "B09c" },
    "04": { "id": "^N[0-9]+$", "example": "N71" },
    "05": { "id": "^TV-(?:[A-Z]+|R[0-9])-[0-9]{2}$", "example": "TV-R1-01" },
    "06": { "id": "^T[0-9]{3}$", "example": "T023" },
    "07": { "id": "^TV-[0-9]{3}$", "example": "TV-020" },
    "08": { "id": "^TV-[A-Z]{1,3}-[0-9]{2}$", "example": "TV-MK-01" },
    "09": { "id": "^T[0-9]{3}$", "example": "T001" },
    "10": { "id": "^TV-[A-Z][0-9]{2}$", "example": "TV-R01" },
    "11": { "id": "^TV-11-[0-9]{3}$", "example": "TV-11-017" },
    "12": { "id": "^T-[A-Z]+-[0-9]{2}$", "example": "T-AUTH-01" },
    "13": { "id": "^TV-[0-9]{3}$", "example": "TV-051" },
    "14": { "id": "^TV-[0-9]{3}$", "example": "TV-001" }
  }
}
