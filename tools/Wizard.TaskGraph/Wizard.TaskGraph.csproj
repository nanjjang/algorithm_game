<Project Sdk="Microsoft.NET.Sdk">
  <!--
    작업 그래프 도구(PIPELINE 3·4절, DECISIONS-TECH T-40·T-41). 명령: Cli.cs 머리말.
    자체 테스트는 Tests/ 에 있고 같은 어셈블리로 빌드된다. 솔루션에 새 테스트 프로젝트를 더하지 않고도
    tools/ci/test.sh(dotnet test Wizard.sln)가 이 테스트를 돌리게 하려는 것이다(IsTestProject).
    진입점은 Program.Main 이다(GenerateProgramFile=false: 테스트 SDK 가 진입점을 따로 만들지 않게).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wizard.TaskGraph</RootNamespace>
    <AssemblyName>Wizard.TaskGraph</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
