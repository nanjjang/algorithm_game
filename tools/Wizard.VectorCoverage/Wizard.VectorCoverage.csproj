<Project Sdk="Microsoft.NET.Sdk">
  <!--
    벡터 대응 검사기(PIPELINE 7.1 G1, CLAUDE.md 8절). 명령: Program.cs 머리말.
    벡터 id 를 모으는 규칙은 tests/vectors.config.json 이고, 그 규칙을 읽는 코드는 Wizard.TestKit.Shared.Vectors 를 그대로 쓴다
    (테스트 쪽과 검사기 쪽이 같은 벡터 목록을 본다).
    자체 테스트는 Tests/ 에 있고 같은 어셈블리로 빌드된다(tools/Wizard.TaskGraph 와 같은 방식. tests/ 의 프로젝트 수는 고정이다).
    진입점은 Program.Main 이다(GenerateProgramFile=false).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wizard.VectorCoverage</RootNamespace>
    <AssemblyName>Wizard.VectorCoverage</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tests/Wizard.TestKit/Shared/Wizard.TestKit.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
