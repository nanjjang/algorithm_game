#!/bin/bash
# pre-commit 훅(PIPELINE 4.6 "커밋 훅"): fast 의 정적 검사 가운데 빠른 것을 올린 파일에 대해 돈다(tools/Wizard.Ci 의 PreCommit):
# 금지 API 빠른 검사, 진단 끄기 금지, 이름 표 형식, 그리고 올린 경로에 닿는 .meta·tasks.json·에이전트 설정·프로젝트 뼈대 검사.
# tools/ci/install-hooks.sh 가 core.hooksPath=tools/ci/hooks(상대 경로)로 건다. 그래서 작업 트리마다 자기 체크아웃의 훅이 돈다.
# git 은 command git 으로만 부른다(CLAUDE.md 9절). bash 3.2 문법만 쓴다.
set -u
case "$0" in */*) _here="${0%/*}" ;; *) _here="." ;; esac
. "$_here/../lib/common.sh"
ROOT="$(ci_root_from "$0")" || exit 1
TOP="$(command git rev-parse --show-toplevel 2>/dev/null)" || TOP=""
# 두 뿌리를 같은 꼴로 견준다(ci_root_from 은 ci_path 를 거친 꼴을 낸다. Windows 에서 pwd 는 /d/…, git 은 D:/… 를 낸다. T-67 4번)
TOP="$(ci_path "$(cd "${TOP:-.}" && pwd -P)")"
if [ "$TOP" != "$ROOT" ]; then
    echo "pre-commit: 이 훅은 $ROOT 의 것인데 커밋은 $TOP 에서 일어난다. $TOP/tools/ci/install-hooks.sh 로 훅을 다시 건다" >&2
    exit 1
fi
ci_need_dotnet
ci_tool precommit --root "$ROOT"
