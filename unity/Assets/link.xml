<!--
  IL2CPP 코드 제거에서 지킬 어셈블리(T-44). Managed Stripping Level 은 Minimal 로 고정한다.
  Wizard.Client 는 noEngineReferences 라 [Preserve] 를 쓸 수 없고, Newtonsoft 는 리플렉션으로 DTO 를 읽는다.
-->
<linker>
  <assembly fullname="Wizard.Protocol" preserve="all" />
  <assembly fullname="Wizard.Client" preserve="all" />
  <assembly fullname="BouncyCastle.Cryptography" preserve="all" />
  <assembly fullname="Newtonsoft.Json" preserve="all" />
</linker>
